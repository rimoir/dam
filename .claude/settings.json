{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/team-session.py\" start-context || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
